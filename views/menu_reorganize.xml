    <record id="menu_course_interested" model="ir.ui.menu">
        <field name="parent_id" ref="menu_lead_settings_root"/><field name="sequence">22</field></record>
    <record id="menu_lead_source_campaign" model="ir.ui.menu">
        <field name="parent_id" ref="menu_lead_settings_root"/><field name="sequence">23</field></record>
    <record id="menu_lead_user_permissions" model="ir.ui.menu">
        <field name="parent_id" ref="menu_lead_settings_root"/><field name="sequence">30</field></record>
    <record id="menu_lead_user_permissions_bulk" model="ir.ui.menu">
        <field name="parent_id" ref="menu_lead_settings_root"/><field name="sequence">31</field></record>
    <record id="menu_coaching_items" model="ir.ui.menu">
        <field name="parent_id" ref="menu_lead_settings_root"/><field name="sequence">40</field></record>
    <record id="menu_lead_missed_call_wa" model="ir.ui.menu">
        <field name="parent_id" ref="menu_lead_settings_root"/><field name="sequence">41</field></record>
    <record id="menu_lead_merge" model="ir.ui.menu">
