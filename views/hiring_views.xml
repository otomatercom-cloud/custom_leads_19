<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_leads_hiring" model="ir.actions.act_window">
        <field name="name">Hiring Leads</field>
        <field name="res_model">leads.logic</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_hiring', '=', True)]</field>
        <field name="search_view_id" ref="view_leads_logic_search"/>
        <field name="context">{'search_default_filter_my': 0}</field>
    </record>

    <menuitem id="menu_hiring_root" name="Hiring" sequence="11" web_icon="custom_leads_19,static/description/icon.png"
              groups="custom_leads_19.group_lead_hr_assistant,custom_leads_19.group_lead_manager,custom_leads_19.group_super_admin"/>
    <menuitem id="menu_hiring_leads" name="Hiring Leads" parent="menu_hiring_root" action="action_leads_hiring" sequence="1"
              groups="custom_leads_19.group_lead_hr_assistant,custom_leads_19.group_lead_manager,custom_leads_19.group_super_admin"/>

    <record id="action_server_hiring_assign" model="ir.actions.server">
        <field name="name">Assign to HR Assistant</field>
        <field name="model_id" ref="model_leads_logic"/>
        <field name="binding_model_id" ref="model_leads_logic"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('custom_leads_19.group_lead_manager')), (4, ref('custom_leads_19.group_super_admin'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_assign_hiring()</field>
    </record>
</odoo>
