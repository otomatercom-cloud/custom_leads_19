<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_otm_leads_odoo17_crosscheck_form" model="ir.ui.view">
        <field name="name">otm.leads.odoo17.crosscheck.wizard.form</field>
        <field name="model">otm.leads.odoo17.crosscheck.wizard</field>
        <field name="arch" type="xml">
            <form string="Cross-check Leads with Odoo 17">
                <div class="alert alert-info" role="alert">
                    Takes the Odoo 19 leads created in the date range, finds the same phone number in
                    Odoo 17 and <b>adds what Odoo 19 is missing</b> (responses, call logs, follow-ups,
                    lead quality, assignment history ...). Nothing is removed. The <b>Admission Officer</b>
                    and <b>Lead Quality</b> can also be taken from Odoo 17 (choose below).
                    Click <b>Preview</b> first to see the numbers.
                </div>
                <group>
                    <group string="Odoo 19 leads created between">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="only_unlinked"/>
                        <field name="recheck"/>
                    </group>
                    <group string="What to add from Odoo 17">
                        <field name="copy_children"/>
                        <field name="fill_fields"/>
                        <field name="quality_mode"/>
                        <field name="owner_mode"/>
                        <field name="copy_chatter"/>
                        <field name="connection_info"/>
                    </group>
                </group>
                <group string="Result" invisible="not result_text">
                    <field name="result_text" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_preview" type="object" string="Preview (no changes)" class="btn-secondary"/>
                    <button name="action_run" type="object" string="Cross-check &amp; Add Missing Data" class="btn-primary"
                            confirm="Add the missing Odoo 17 data to the Odoo 19 leads in this date range? Nothing will be removed."/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_otm_leads_odoo17_crosscheck" model="ir.actions.act_window">
        <field name="name">Cross-check with Odoo 17</field>
        <field name="res_model">otm.leads.odoo17.crosscheck.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_leads_odoo17_crosscheck" name="Cross-check with Odoo 17"
              parent="menu_leads_odoo17_import" action="action_otm_leads_odoo17_crosscheck" sequence="2"
              groups="custom_leads_19.group_super_admin"/>
</odoo>
