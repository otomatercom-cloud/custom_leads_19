<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_res_config_settings_leads" model="ir.ui.view">
        <field name="name">res.config.settings.leads</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Leads" name="custom_leads_19" groups="custom_leads_19.group_super_admin">
                    <block title="Voxbay Click-to-Call">
                        <setting string="Voxbay UID">
                            <field name="voxbay_uid"/>
                        </setting>
                        <setting string="Voxbay UPIN">
                            <field name="voxbay_upin"/>
                        </setting>
                        <setting string="Caller ID (DID)">
                            <field name="voxbay_callerid"/>
                        </setting>
                        <setting string="Auto-Create Lead (Incoming)"
                                 help="Create a new lead when an incoming call comes from an unknown number.">
                            <field name="auto_create_lead_incoming"/>
                        </setting>
                        <setting string="Auto-Create Lead (Outgoing)"
                                 help="Create a new lead when an outgoing call is dialed to an unknown number.">
                            <field name="auto_create_lead_outgoing"/>
                        </setting>
                    </block>
                    <block title="Bonvoice Click-to-Call">
                        <setting string="Username">
                            <field name="bonvoice_username"/>
                        </setting>
                        <setting string="Password">
                            <field name="bonvoice_password" password="True"/>
                        </setting>
                        <setting string="API URL">
                            <field name="bonvoice_url"/>
                        </setting>
                        <setting string="Leg A Caller ID">
                            <field name="bonvoice_leg_a_caller_id"/>
                        </setting>
                        <setting string="Leg B Caller ID">
                            <field name="bonvoice_leg_b_caller_id"/>
                        </setting>
                        <setting string="Webhook URL (call tracking)" help="Paste this URL in the Bonvoice panel as the CDR / call-event callback URL. It contains a secret token - do not share it publicly.">
                            <field name="bonvoice_webhook_url" readonly="1"/>
                        </setting>
                    </block>
                    <block title="Meta WhatsApp">
                        <setting string="Meta Verify Token">
                            <field name="meta_verify_token"/>
                        </setting>
                        <setting string="Meta Page Access Token">
                            <field name="meta_page_access_token"/>
                        </setting>
                    </block>
                    <block title="Odoo 17 Sync">
                        <setting string="Sync Lead Changes to Odoo 17"
                                 help="One-way: changes to imported leads are pushed to the old Odoo 17 lead every few minutes.">
                            <field name="otm_odoo17_sync_enabled"/>
                        </setting>
                    </block>
                    <block title="Follow-Up Popup">
                        <setting string="Enable Follow-Up Popup"
                                 help="Show a popup with today's follow-ups when opening the Leads view.">
                            <field name="enable_followup_popup"/>
                        </setting>
                    </block>
                    <block title="Urgent New-Lead Popup">
                        <setting string="Show urgent popup for new leads"
                                 help="When a lead with quality New is assigned to an admission officer, a red 'Urgent - call now' card with the lead details appears on their screen (even during another call) and returns every few minutes until the lead is worked.">
                            <field name="urgent_lead_popup"/>
                        </setting>
                        <setting string="Only for these lead sources"
                                 help="Choose Meta (or any sources) to show the urgent popup only for them. Leave empty for every source. Popups already waiting for other sources are closed automatically.">
                            <field name="urgent_source_ids" widget="many2many_tags" options="{'no_create': True}"
                                   invisible="not urgent_lead_popup"/>
                        </setting>
                        <setting string="Only recent leads" invisible="not urgent_lead_popup"
                                 help="Days back a lead may have arrived and still raise the popup. 0 = today only, 1 = yesterday and today. The popup also shows only on the day the lead is assigned.">
                            <field name="urgent_age_days"/>
                        </setting>
                        <setting string="RNR call needed popup" invisible="not urgent_lead_popup"
                                 help="After this hour (24h clock, India time) the officer gets a popup for a lead they called but nobody answered, if it was not called again since that hour. Hidden as soon as they call. 0 = off.">
                            <field name="urgent_rnr_hour"/>
                        </setting>
                    </block>
                    <block title="Crash Course">
                        <setting string="Crash Course option"
                                 help="ON: an officer can move a lead to the Crash Course menu (checkbox and button on the lead). OFF: the option and the menu are hidden, and those leads show in Leads again.">
                            <field name="group_crash_course_on"/>
                        </setting>
                    </block>
                    <block title="Call Timer Popup">
                        <setting string="Enable Call Timer Popup"
                                 help="When ON: clicking Call opens the timer overlay with duration tracking and recording. When OFF: clicking Call directly dials via tel: link with no overlay.">
                            <field name="enable_call_timer"/>
                            <div class="text-muted ms-2" style="font-size:12px;margin-top:-6px;margin-bottom:8px;">
                                Show countdown timer during calls
                            </div>
                            <field name="admission_batch_required"/>
                            <div class="text-muted ms-2" style="font-size:12px;margin-top:-6px;">
                                When ON — officers must pick a batch &amp; fee to confirm admission.<br/>
                                When OFF — one click converts lead to admission (no batch/fee needed).
                            </div>
                        </setting>
                    </block>
                    <block title="Lead rules">
                        <setting string="Called fast within (hours)" help="Used by the Response Performance dashboard.">
                            <field name="lead_called_fast_hrs"/>
                        </setting>
                        <setting string="Calls needed before Ringing Not Responding" help="0 = no limit. Applies to every officer.">
                            <field name="lead_rnr_min_calls"/>
                        </setting>
                        <setting string="Gap between RNR calls"
                                 help="Calls closer than the gap count as one call. The gap depends on when the lead came in. Morning gap 0 = no gap rule.">
                            <div class="content-group">
                                <div class="row mt8"><label class="col-lg-6" for="lead_rnr_gap_min"/><field name="lead_rnr_gap_min"/></div>
                                <div class="row"><label class="col-lg-6" for="lead_rnr_gap_noon_min"/><field name="lead_rnr_gap_noon_min"/></div>
                                <div class="row"><label class="col-lg-6" for="lead_rnr_gap_eve_min"/><field name="lead_rnr_gap_eve_min"/></div>
                                <div class="row"><label class="col-lg-6" for="lead_rnr_day_start"/><field name="lead_rnr_day_start"/></div>
                                <div class="row"><label class="col-lg-6" for="lead_rnr_day_end"/><field name="lead_rnr_day_end"/></div>
                                <div class="row"><label class="col-lg-6" for="lead_rnr_genuine_gap"/><field name="lead_rnr_genuine_gap"/></div>
                                <div class="row"><label class="col-lg-6" for="lead_rnr_gap_tolerance"/><field name="lead_rnr_gap_tolerance"/></div>
                                <div class="row"><label class="col-lg-6" for="lead_rnr_noon_hour"/><field name="lead_rnr_noon_hour"/></div>
                                <div class="row"><label class="col-lg-6" for="lead_rnr_eve_hour"/><field name="lead_rnr_eve_hour"/></div>
                            </div>
                        </setting>
                        <setting string="Short call is under (seconds)" help="Used by the Short calls report.">
                            <field name="lead_short_call_secs"/>
                        </setting>
                        <setting string="Coaching pass score (%)" help="Officers below this average show as Needs help.">
                            <field name="coaching_pass_score"/>
                        </setting>
                    </block>
                    <block title="Call priority (Call next list)">
                        <setting string="Points per lead quality" help="Hot, Warm, Cold ... each quality has its own points. The biggest number is called first.">
                            <button name="%(custom_leads_19.action_lead_score_quality)d" type="action" string="Open points table" class="btn-link" icon="oi-arrow-right"/>
                        </setting>
                        <setting string="New lead" help="Points for how recently the lead arrived.">
                            <field name="score_w_fresh"/>
                        </setting>
                        <setting string="Not called yet" help="Full points when there are no calls, fewer with every call.">
                            <field name="score_w_calls"/>
                        </setting>
                        <setting string="Lead source" help="Sources with a better admission rate get more.">
                            <field name="score_w_source"/>
                        </setting>
                        <setting string="Course" help="Courses with a better admission rate get more.">
                            <field name="score_w_course"/>
                        </setting>
                        <setting string="Follow-up due" help="Added when a follow-up is due today or overdue.">
                            <field name="score_w_due"/>
                        </setting>
                    </block>
                    <block title="WhatsApp after a missed call">
                        <setting string="Send automatically" help="When an outgoing call is not answered, a WhatsApp message goes to the lead (one per lead per day). Needs a WhatsApp sender module to be connected.">
                            <field name="wa_missed_enabled"/>
                        </setting>
                        <setting string="Message" help="Placeholders: {name} {officer} {course} {institute}">
                            <field name="wa_missed_template"/>
                        </setting>
                        <setting string="Sending hours" help="Messages outside these hours wait until the next morning window.">
                            <field name="wa_missed_from_hour"/> to <field name="wa_missed_to_hour"/>
                        </setting>
                    </block>
                    <block title="Evening summary for managers">
                        <setting string="Send every evening at 7 pm" help="New leads, calls, uncalled leads, missed follow-ups and admissions per officer, to managers and super admins.">
                            <field name="daily_summary_enabled"/>
                            <div class="mt-2"><field name="daily_summary_telegram"/> <label for="daily_summary_telegram"/>
                                <field name="daily_summary_email" class="ms-3"/> <label for="daily_summary_email"/></div>
                            <div class="mt-2">
                                <button name="action_daily_summary_test" type="object" class="btn btn-secondary"
                                        string="Save &amp; send test to me"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Top-up pool">
                        <setting string="Give new leads to officers who finish their calls"
                                 help="Leads in the top-up pool (ticked Top-up pool, or from a source marked Feeds the top-up pool) are not given out by the normal assignment. When an officer has called everything for today, more leads are added to their list automatically.">
                            <field name="topup_enabled"/>
                            <div class="content-group" invisible="not topup_enabled">
                                <div class="row mt8"><label class="col-lg-5" for="topup_pending_max"/><field name="topup_pending_max"/></div>
                                <div class="row"><label class="col-lg-5" for="topup_batch"/><field name="topup_batch"/></div>
                                <div class="row"><label class="col-lg-5" for="topup_daily_cap"/><field name="topup_daily_cap"/></div>
                                <div class="row"><label class="col-lg-5" for="topup_min_calls"/><field name="topup_min_calls"/></div>
                                <div class="row"><label class="col-lg-5" for="topup_cooldown"/><field name="topup_cooldown"/></div>
                                <div class="row"><label class="col-lg-5" for="topup_attendance"/><field name="topup_attendance"/></div>
                                <div class="row"><label class="col-lg-5" for="topup_from_hour"/><field name="topup_from_hour"/></div>
                                <div class="row"><label class="col-lg-5" for="topup_to_hour"/><field name="topup_to_hour"/></div>
                                <div class="mt-2">
                                    <button name="action_topup_run_now" type="object" class="btn btn-secondary"
                                            string="Save &amp; run now"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Daily report on WhatsApp">
                        <setting string="Send the daily leads report on WhatsApp"
                                 help="New leads, assigned, first call within 15 / 30 / 60 / 120 minutes, RNR, top performers and admissions. Sent once every evening to the numbers below with the WhatsApp Cloud API.">
                            <field name="wa_report_enabled"/>
                            <div class="content-group" invisible="not wa_report_enabled">
                                <div class="row mt8"><label class="col-lg-4" for="wa_report_phone_id"/><field name="wa_report_phone_id"/></div>
                                <div class="row"><label class="col-lg-4" for="wa_report_token"/><field name="wa_report_token" password="True"/></div>
                                <div class="row"><label class="col-lg-4" for="wa_report_to"/><field name="wa_report_to"/></div>
                                <div class="row"><label class="col-lg-4" for="wa_report_template"/><field name="wa_report_template"/></div>
                                <div class="row"><label class="col-lg-4" for="wa_report_lang"/><field name="wa_report_lang"/></div>
                                <div class="row"><label class="col-lg-4" for="wa_report_hour"/><field name="wa_report_hour"/></div>
                                <div class="mt-2">
                                    <button name="action_wa_report_test" type="object" class="btn btn-secondary"
                                            string="Save &amp; send report now"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Odoo 17 admission">
                        <setting string="Admission (Odoo 17) button"
                                 help="Shows the 🎓 Admission (Odoo 17) button on the lead form. It sends the lead to Odoo 17 and opens it there. Turn it off when admission moves to Odoo 19.">
                            <field name="odoo17_admission_button"/>
                        </setting>
                    </block>
                    <block title="AI call analysis">
                        <setting string="Analyse call recordings with AI"
                                 help="Every few minutes connected calls that have a recording are transcribed and reviewed: summary, student interest, officer score and whether the lead quality matches the call. Needs the API keys below. The audio is sent to the AI providers; cost depends on call minutes.">
                            <field name="ai_call_enabled"/>
                        </setting>
                        <setting string="Speech-to-text" invisible="not ai_call_enabled">
                            <div class="content-group">
                                <div class="row mt8"><label class="col-lg-4" for="ai_stt_provider"/><field name="ai_stt_provider"/></div>
                                <div class="row"><label class="col-lg-4" for="ai_stt_key"/><field name="ai_stt_key" password="True"/></div>
                                <div class="row"><label class="col-lg-4" for="ai_stt_model"/><field name="ai_stt_model"/></div>
                                <div class="row"><label class="col-lg-4" for="ai_stt_language"/><field name="ai_stt_language"/></div>
                            </div>
                        </setting>
                        <setting string="AI review" invisible="not ai_call_enabled">
                            <div class="content-group">
                                <div class="row mt8"><label class="col-lg-4" for="ai_llm_provider"/><field name="ai_llm_provider"/></div>
                                <div class="row"><label class="col-lg-4" for="ai_llm_key"/><field name="ai_llm_key" password="True"/></div>
                                <div class="row"><label class="col-lg-4" for="ai_llm_model"/><field name="ai_llm_model"/></div>
                            </div>
                        </setting>
                        <setting string="Cost control" invisible="not ai_call_enabled"
                                 help="Only connected calls with a recording are analysed, newest first.">
                            <div class="content-group">
                                <div class="row mt8"><label class="col-lg-4" for="ai_min_seconds"/><field name="ai_min_seconds"/></div>
                                <div class="row"><label class="col-lg-4" for="ai_daily_limit"/><field name="ai_daily_limit"/></div>
                                <div class="row"><label class="col-lg-4" for="ai_max_age_days"/><field name="ai_max_age_days"/></div>
                            </div>
                        </setting>
                    </block>
                    <block title="Meta Ads (spend and CPL)">
                        <setting string="Meta Marketing API"
                                 help="Pulls the daily spend of each campaign so the Meta Ads dashboard can show spend and cost per lead. Needs a System User access token with ads_read and the ad account ID.">
                            <div class="content-group">
                                <div class="row mt8"><label class="col-lg-4" for="meta_ads_accounts"/><field name="meta_ads_accounts"/></div>
                                <div class="row"><label class="col-lg-4" for="meta_ads_token"/><field name="meta_ads_token" password="True"/></div>
                                <div class="row"><label class="col-lg-4" for="meta_ads_version"/><field name="meta_ads_version"/></div>
                                <div class="row"><label class="col-lg-4" for="meta_ads_days"/><field name="meta_ads_days"/></div>
                            </div>
                        </setting>
                        <setting string="Sync automatically" help="Refreshes the last 3 days of spend every hour.">
                            <field name="meta_ads_enabled"/>
                        </setting>
                    </block>
                    <block title="Call button">
                        <setting string="Call button uses" help="The 📞 Call button on a lead dials through this service and the call is recorded and logged by it.">
                            <field name="call_provider"/>
                        </setting>
                        <setting string="Phone app link" help="Used by the Softphone option. Use sip: if MicroSIP or Zoiper is set as the handler for sip links, otherwise tel:."
                                 invisible="call_provider not in ('softphone', 'auto')">
                            <field name="dial_scheme"/>
                        </setting>
                    </block>
                    <block title="User guide">
                        <setting string="Show the user guide menu" help="Adds a 'Lead User Guide' main menu that explains every menu and option. Switch off to hide it.">
                            <field name="lead_guide_enabled"/>
                        </setting>
                    </block>
                    <block title="Daily Call Goal">
                        <setting string="Calls per officer per day" help="Shown as the progress ring on each officer's dashboard in the Next.js app.">
                            <field name="daily_call_goal"/>
                        </setting>
                    </block>
                    <block title="Telegram Follow-Up Alerts">
                        <setting string="Enable Telegram alerts" help="Officers get Telegram messages for new, due-soon and overdue follow-ups plus a morning digest. Each officer's Chat ID is set on the user form (Call Settings tab).">
                            <field name="telegram_enabled"/>
                        </setting>
                        <setting string="Bot Token" help="Create a bot with @BotFather in Telegram and paste the token here.">
                            <field name="telegram_bot_token" password="True"/>
                        </setting>
                        <setting string="Reminder before due time (minutes)">
                            <field name="telegram_reminder_minutes"/>
                        </setting>
                        <setting string="Morning digest (9:00 AM)" help="One message per officer listing today's follow-ups.">
                            <field name="telegram_digest"/>
                            <div class="mt-2">
                                <button name="action_telegram_test_me" type="object" class="btn btn-secondary"
                                        string="Save &amp; send test to me"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Telegram updates for managers">
                        <setting string="Morning, afternoon and evening updates"
                                 help="Number of leads created (with Meta leads shown separately), officer attendance and, in the evening, the full daily report. Sent by Telegram to managers and super admins who have a Chat ID. Uses the Bot Token above.">
                            <field name="tgrep_enabled"/>
                            <div class="content-group" invisible="not tgrep_enabled">
                                <div class="row mt8"><label class="col-lg-4" for="tgrep_morning"/><field name="tgrep_morning"/></div>
                                <div class="row"><label class="col-lg-4" for="tgrep_afternoon"/><field name="tgrep_afternoon"/></div>
                                <div class="row"><label class="col-lg-4" for="tgrep_evening"/><field name="tgrep_evening"/></div>
                                <div class="row"><label class="col-lg-4" for="tgrep_team_leads"/><field name="tgrep_team_leads"/></div>
                                <div class="row"><label class="col-lg-4" for="tgrep_late_after"/><field name="tgrep_late_after"/></div>
                                <div class="mt-2">
                                    <button name="action_tgrep_test" type="object" class="btn btn-secondary"
                                            string="Save &amp; send the evening report to me"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Demo Data (for demonstrations / training only)">
                        <setting string="Demo users, teams &amp; leads"
                                 help="Creates demo users for every role (password Demo@1234), 2 teams, sources, ~40 leads with calls, follow-ups and re-attempts. Never load on a live database - remove it afterwards.">
                            <div class="mt-2">
                                <button name="action_load_demo_data" type="object" class="btn btn-primary"
                                        string="Load Demo Data"
                                        confirm="Create demo users, teams and leads? Use only on a demo/training database."/>
                                <button name="action_remove_demo_data" type="object" class="btn btn-secondary ms-2"
                                        string="Remove Demo Data"
                                        confirm="Delete all demo users, teams and leads created by Load Demo Data?"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
