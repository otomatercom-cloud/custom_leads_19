<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_users_leads_form" model="ir.ui.view">
        <field name="name">res.users.leads.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="after">
                <page string="Call Settings" name="call_settings">
                    <group string="Voxbay">
                        <field name="voxbay_user_no"/>
                    </group>
                    <group string="Telegram Follow-Up Alerts">
                        <field name="telegram_notify"/>
                        <field name="telegram_chat_id"/>
                        <field name="telegram_username" placeholder="without @"/>
                        <div colspan="2">
                            <button name="action_find_telegram_chat_id" type="object"
                                    string="Find my Chat ID" class="btn-secondary"/>
                            <button name="action_send_test_telegram" type="object"
                                    string="Send Test Message" class="btn-secondary ms-2"/>
                        </div>
                    </group>
                    <group string="Bonvoice">
                        <field name="bonvoice_agent_number"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
