<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Built-in stage categories and lead qualities. noupdate: edits made in the UI survive upgrades. -->
    <record id="stage_funnel" model="lead.stage.category">
        <field name="name">FUNNEL</field>
        <field name="code">funnel</field>
        <field name="sequence">10</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="stage_prospects" model="lead.stage.category">
        <field name="name">PROSPECTS</field>
        <field name="code">prospects</field>
        <field name="sequence">20</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="stage_rnr_dnp" model="lead.stage.category">
        <field name="name">RNR / DNP</field>
        <field name="code">rnr_dnp</field>
        <field name="sequence">30</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="stage_admission_done" model="lead.stage.category">
        <field name="name">ADMISSION DONE</field>
        <field name="code">admission_done</field>
        <field name="sequence">40</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="stage_re_try" model="lead.stage.category">
        <field name="name">RE-TRY</field>
        <field name="code">re_try</field>
        <field name="sequence">50</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="stage_alumni" model="lead.stage.category">
        <field name="name">ALUMNI</field>
        <field name="code">alumni</field>
        <field name="sequence">60</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="stage_junk" model="lead.stage.category">
        <field name="name">JUNK</field>
        <field name="code">junk</field>
        <field name="sequence">70</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="quality_new" model="lead.quality.config">
        <field name="name">🆕  New</field>
        <field name="code">new</field>
        <field name="stage_id" ref="stage_funnel"/>
        <field name="sequence">10</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="quality_first_attempt" model="lead.quality.config">
        <field name="name">🎯 First Attempt</field>
        <field name="code">first_attempt</field>
        <field name="stage_id" ref="stage_funnel"/>
        <field name="sequence">20</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="quality_waiting_for_admission" model="lead.quality.config">
        <field name="name">⏳  Waiting for Admission</field>
        <field name="code">waiting_for_admission</field>
        <field name="stage_id" ref="stage_prospects"/>
        <field name="sequence">30</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="quality_admission" model="lead.quality.config">
        <field name="name">🎓  Admission</field>
        <field name="code">admission</field>
        <field name="stage_id" ref="stage_admission_done"/>
        <field name="sequence">40</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="quality_hot" model="lead.quality.config">
        <field name="name">🔥  Hot</field>
        <field name="code">hot</field>
        <field name="stage_id" ref="stage_prospects"/>
        <field name="sequence">50</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="quality_warm" model="lead.quality.config">
        <field name="name">🌞  Warm</field>
        <field name="code">warm</field>
        <field name="stage_id" ref="stage_prospects"/>
        <field name="sequence">60</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="quality_cold" model="lead.quality.config">
        <field name="name">❄️  Cold</field>
        <field name="code">cold</field>
        <field name="stage_id" ref="stage_prospects"/>
        <field name="sequence">70</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="quality_bad_lead" model="lead.quality.config">
        <field name="name">⚠️  Language Barrier</field>
        <field name="code">bad_lead</field>
        <field name="stage_id" ref="stage_re_try"/>
        <field name="sequence">80</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="quality_crash_lead" model="lead.quality.config">
        <field name="name">💥  Crash Lead</field>
        <field name="code">crash_lead</field>
        <field name="stage_id" ref="stage_re_try"/>
        <field name="sequence">90</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="quality_not_responding" model="lead.quality.config">
        <field name="name">🔕  Ringing Not Responding</field>
        <field name="code">not_responding</field>
        <field name="stage_id" ref="stage_rnr_dnp"/>
        <field name="sequence">100</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="quality_call_later" model="lead.quality.config">
        <field name="name">📞  Call Later</field>
        <field name="code">call_later</field>
        <field name="stage_id" ref="stage_prospects"/>
        <field name="sequence">110</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="quality_may_be_later" model="lead.quality.config">
        <field name="name">🔔 May Be Later</field>
        <field name="code">may_be_later</field>
        <field name="stage_id" ref="stage_prospects"/>
        <field name="sequence">120</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="quality_follow_up" model="lead.quality.config">
        <field name="name">⏰  Follow Up</field>
        <field name="code">follow_up</field>
        <field name="stage_id" ref="stage_funnel"/>
        <field name="sequence">130</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="quality_not_reachable" model="lead.quality.config">
        <field name="name">🚫  Not Reachable</field>
        <field name="code">not_reachable</field>
        <field name="stage_id" ref="stage_rnr_dnp"/>
        <field name="sequence">140</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="quality_logic_students" model="lead.quality.config">
        <field name="name">🏫 Logic Students</field>
        <field name="code">logic_students</field>
        <field name="stage_id" ref="stage_alumni"/>
        <field name="sequence">150</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="quality_joined_other_institute" model="lead.quality.config">
        <field name="name">🏫 Joined Other Institute</field>
        <field name="code">joined_other_institute</field>
        <field name="stage_id" ref="stage_re_try"/>
        <field name="sequence">160</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="quality_wrong_number" model="lead.quality.config">
        <field name="name">📵 Wrong number</field>
        <field name="code">wrong_number</field>
        <field name="stage_id" ref="stage_junk"/>
        <field name="sequence">170</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="quality_not_enquiry" model="lead.quality.config">
        <field name="name">🛑 Not Enquiry</field>
        <field name="code">not_enquiry</field>
        <field name="stage_id" ref="stage_junk"/>
        <field name="sequence">180</field>
        <field name="is_system" eval="True"/>
    </record>
    <record id="quality_not_interested" model="lead.quality.config">
        <field name="name">Not Interested</field>
        <field name="code">not_interested</field>
        <field name="stage_id" ref="stage_re_try"/>
        <field name="sequence">190</field>
        <field name="is_system" eval="True"/>
    </record>
</odoo>
