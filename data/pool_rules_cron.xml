<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_pool_reassign_uncalled" model="ir.cron">
        <field name="name">Leads: Pool reassign leads not called enough</field>
        <field name="model_id" ref="model_lead_assignment_rule"/>
        <field name="state">code</field>
        <field name="code">model.cron_pool_reassign_uncalled()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_pool_reassign_not_called_quickly" model="ir.cron">
        <field name="name">Leads: Pool reassign leads not called in time</field>
        <field name="model_id" ref="model_lead_assignment_rule"/>
        <field name="state">code</field>
        <field name="code">model.cron_pool_reassign_not_called_quickly()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_urgent_rnr_alerts" model="ir.cron">
        <field name="name">Leads: RNR call needed popup (after noon)</field>
        <field name="model_id" ref="model_lead_urgent_alert"/>
        <field name="state">code</field>
        <field name="code">model.cron_rnr_alerts()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_ai_analyse_calls" model="ir.cron">
        <field name="name">Leads: AI call analysis</field>
        <field name="model_id" ref="model_lead_call_log"/>
        <field name="state">code</field>
        <field name="code">model.cron_ai_analyse_calls()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_topup_pool" model="ir.cron">
        <field name="name">Leads: Top-up pool (leads for officers who finished)</field>
        <field name="model_id" ref="model_leads_logic"/>
        <field name="state">code</field>
        <field name="code">model.cron_topup()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
